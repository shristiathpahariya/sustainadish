# Backend Environment Variables

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=sustainadish

# Security Configuration
JWT_SECRET=<your-super-secret-jwt-key-change-this>
JWT_EXPIRY=7d

# Server Configuration
PORT=3000
NODE_ENV=development

# Flask ML service (recipe recommendations — used by GET /api/landing/recipe-picks)
# ML_API_URL=http://127.0.0.1:5000


# CORS Configuration
# CORS_ORIGIN=http://localhost:3000 (for development)
# CORS_ORIGIN=https://yourdomain.com (for production)

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW_MS=900000 (15 minutes)
# RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
# MAX_FILE_SIZE=5242880 (5MB in bytes)